<!DOCTYPE html>
<html lang="de" data-theme="dark">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>WebTV - TVheadend Player</title>
    <!-- Bulma 1.0 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@1.0.0/css/bulma.min.css">

    <style>
        /* Layout Reset & Fullscreen-Setup */
        html,
        body {
            margin: 0;
            padding: 0;
            width: 100vw;
            height: 100vh;
            overflow: hidden;
            background-color: #000;
            font-family: BlinkMacSystemFont, -apple-system, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        }

        /* Video Player in perfektem 16:9 Format zentriert */
        #videoPlayer {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 100vw;
            height: 56.25vw;
            /* Enforces 16:9 ratio (9/16 = 0.5625) */
            max-height: 100vh;
            max-width: 177.78vh;
            /* Enforces 16:9 ratio (16/9 = 1.7778) */
            object-fit: contain;
            z-index: 1;
            background: #000;
        }

        /* Transparente Sidebar links mit Animation */
        .sidebar {
            position: absolute;
            top: 0;
            left: 0;
            width: 380px;
            height: 100vh;
            z-index: 10;
            background: rgba(15, 15, 20, 0.88);
            backdrop-filter: blur(12px);
            border-right: 1px solid rgba(255, 255, 255, 0.1);
            display: flex;
            flex-direction: column;

            /* Animation für geschmeidiges Ein-/Ausblenden */
            transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
            transform: translateX(0);
            opacity: 1;
        }

        /* Zustand wenn die Sidebar versteckt ist */
        .sidebar.is-hidden {
            transform: translateX(-100%);
            opacity: 0;
            pointer-events: none;
            /* Klicks auf ausgeblendete Leiste verhindern */
        }

        /* Header & Scrollbar-Styling */
        .sidebar-header {
            padding: 20px 20px 15px 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .channel-list {
            flex: 1;
            overflow-y: auto;
            padding: 10px 15px;
        }

        .channel-list::-webkit-scrollbar {
            width: 6px;
        }

        .channel-list::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.2);
            border-radius: 3px;
        }

        /* Einzelne Sender-Items */
        .channel-item {
            padding: 12px 15px;
            margin-bottom: 8px;
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.05);
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .channel-item:hover {
            background: rgba(255, 255, 255, 0.1);
            transform: translateX(4px);
        }

        .channel-item.is-active {
            background: rgba(0, 209, 178, 0.2);
            border-color: #00d1b2;
        }

        .channel-title {
            font-weight: 600;
            color: #fff;
            font-size: 1.05rem;
        }

        .epg-title {
            color: #b5b5b5;
            font-size: 0.85rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .epg-time {
            color: #888;
            font-size: 0.75rem;
        }

        .epg-progress {
            height: 3px !important;
            margin-top: 6px !important;
            background-color: rgba(255, 255, 255, 0.1) !important;
        }

        /* Platzhalter Overlay über dem Video */
        .player-placeholder {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 100vw;
            height: 56.25vw;
            max-height: 100vh;
            max-width: 177.78vh;
            z-index: 2;
            /* Liegt über dem Video (Video hat z-index: 1) */

            /* OPTION A: Eigenes Hintergrundbild einbinden */
            /* background: url('https://dein-bild-link.jpg') center/cover no-repeat; */

            /* OPTION B: Dunkler, eleganter Farbverlauf als Standard */
            background: radial-gradient(circle, rgba(30, 35, 45, 1) 0%, rgba(10, 12, 16, 1) 100%);

            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            transition: opacity 0.4s ease;
        }

        /* Versteck-Zustand für das Overlay */
        .player-placeholder.is-hidden {
            opacity: 0;
            pointer-events: none;
            /* Klicks durchlassen, sobald es ausgeblendet ist */
        }

        .placeholder-content {
            padding: 2rem;
            background: rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(8px);
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        /* Layout-Anpassung für Items mit Logo */
        .channel-item-content {
            display: flex;
            align-items: center;
            gap: 12px;
            /* Abstand zwischen Logo und Text */
        }

        /* Picon / Logo Container */
        .channel-logo {
            width: 48px;
            height: 36px;
            object-fit: contain;
            /* Erhält das Seitenverhältnis des Logos */
            background: rgba(0, 0, 0, 0.3);
            border-radius: 4px;
            padding: 2px;
            flex-shrink: 0;
            /* Verhindert, dass das Logo zusammengedrückt wird */
        }

        /* Container für Name und EPG rechts neben dem Logo */
        .channel-info {
            flex-grow: 1;
            min-width: 0;
            /* Wichtig für Text-Ellipsis bei langen Sendernamen */
        }
    </style>

</head>

<body>

    <!-- 1. Fullscreen Player im Hintergrund -->
    <video id="videoPlayer" controls autoplay></video>

    <!-- Platzhalter / Cover-Bild wenn kein Sender läuft -->
    <div id="playerPlaceholder" class="player-placeholder">
        <div class="placeholder-content">
            <p class="is-size-1">📺</p>
            <p class="title is-4 has-text-white mt-2">Willkommen bei WebTV</p>
            <p class="subtitle is-6 has-text-grey-light">Wähle links einen Sender aus, um das Live-Programm zu starten.
            </p>
        </div>
    </div>

    <!-- 2. Transparente Sidebar links -->
    <div class="sidebar">
        <div class="sidebar-header">
            <h1 class="title is-4 has-text-white mb-1">📺 WebTV</h1>
            <p class="subtitle is-7 has-text-grey-light">TVheadend Streamer</p>
        </div>

        <!-- Container für Senderliste -->
        <div id="channelList" class="channel-list">
            <p class="has-text-grey p-3">Lade Sender und EPG...</p>
        </div>
    </div>

    <script>
        let currentActiveChannel = null;

        function playStream(channelId) {
            const video = document.getElementById('videoPlayer');
            const placeholder = document.getElementById('playerPlaceholder');

            // 1. Platzhalter ausblenden (falls vorhanden)
            if (placeholder) {
                placeholder.classList.add('is-hidden');
            }

            // 2. Vorherigen Stream stoppen & Quelle zurücksetzen
            video.pause();
            video.src = `/video_proxy/${channelId}`;
            video.load();

            // 3. Warten, bis der Browser bereit ist, bevor play() aufgerufen wird
            const playPromise = video.play();

            if (playPromise !== undefined) {
                playPromise.catch(error => {
                    // AbortError ist vollkommen normal, wenn man schnell Sender wechselt
                    if (error.name === 'AbortError') {
                        console.log("Wiedergabe-Wechsel unterbrochen (normal beim Senderwechsel).");
                    } else {
                        console.error("Echter Wiedergabefehler:", error);
                    }
                });
            }
        }

        // Hilfsfunktion: Formatierung von UNIX-Timestamps zu HH:MM Uhr
        function formatTime(timestamp) {
            if (!timestamp) return '--:--';
            const date = new Date(timestamp * 1000);
            return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        }

        // Sender und EPG-Daten laden
        async function loadChannelsAndEPG() {
            const container = document.getElementById('channelList');

            try {
                const [channelsRes, epgRes] = await Promise.all([
                    fetch('/api/channels'),
                    fetch('/api/epg')
                ]);

                const channelsData = await channelsRes.json();
                const epgData = await epgRes.json();

                const now = Math.floor(Date.now() / 1000);
                const currentEvents = {};

                if (epgData.entries) {
                    epgData.entries.forEach(event => {
                        if (event.start <= now && event.stop >= now) {
                            currentEvents[event.channelUuid] = event;
                        }
                    });
                }

                container.innerHTML = '';

                if (channelsData.entries) {
                    channelsData.entries.forEach(channel => {
                        const event = currentEvents[channel.uuid];
                        let epgHtml = '<div class="epg-title">Keine EPG-Daten</div>';

                        if (event) {
                            const startTime = formatTime(event.start);
                            const stopTime = formatTime(event.stop);
                            const totalDuration = event.stop - event.start;
                            const elapsed = now - event.start;
                            const progressPercent = Math.min(100, Math.max(0, (elapsed / totalDuration) * 100));

                            epgHtml = `
            <div class="epg-title">${event.title}</div>
            <div class="epg-time">${startTime} - ${stopTime}</div>
            <progress class="progress is-primary epg-progress" value="${progressPercent}" max="100"></progress>
        `;
                        }

                        const item = document.createElement('div');
                        item.id = `channel-${channel.uuid}`;
                        item.className = 'channel-item';
                        item.onclick = () => playStream(channel.uuid);

                        // 1. Element-Gerüst bauen
                        item.innerHTML = `
        <div class="channel-item-content">
            <img class="channel-logo" alt="${channel.name}" />
            <div class="channel-info">
                <div class="channel-title">${channel.name}</div>
                ${epgHtml}
            </div>
        </div>
    `;

                        // 2. Logo & Fehlerbehandlung sauber über JS zuweisen (kein onerror im HTML-String!)
                        const img = item.querySelector('.channel-logo');
                        const logoUrl = `http://192.168.10.11:8000/${encodeURIComponent(channel.name)}.png`;
                        const fallbackSvg = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='48' height='36' viewBox='0 0 24 24' fill='none' stroke='%23888888' stroke-width='2'><rect x='2' y='7' width='20' height='15' rx='2'/><path d='M17 2l-5 5-5-5'/></svg>";

                        img.src = logoUrl;
                        img.onerror = function () {
                            this.onerror = null; // Verhindert Endlosschleife
                            this.src = fallbackSvg;
                        };

                        container.appendChild(item);
                    });
                }
            } catch (err) {
                console.error(err);
                container.innerHTML = `<div class="has-text-danger p-3">Fehler beim Laden!</div>`;
            }
        }

        // --- AUTO-HIDE LOGIK FÜR SENDERLISTE ---
        let hideTimer = null;
        const sidebar = document.querySelector('.sidebar');
        const channelList = document.getElementById('channelList');

        function resetHideTimer() {
            // Sidebar & Mauszeiger wieder einblenden
            sidebar.classList.remove('is-hidden');
            document.body.style.cursor = 'default';

            // Alten Timer zurücksetzen
            clearTimeout(hideTimer);

            // Nach 3,5 Sekunden Inaktivität ausblenden
            hideTimer = setTimeout(() => {
                sidebar.classList.add('is-hidden');
                document.body.style.cursor = 'none'; // Blendet auch den Mauszeiger aus
            }, 3500);
        }

        // 1. Bei Mausbewegung
        window.addEventListener('mousemove', resetHideTimer);

        // 2. Bei Mausklick
        window.addEventListener('click', resetHideTimer);

        // 3. NEU: Bei Mausrad-Drehen (Wheel Event) - reagiert sofort beim Scrollen mit der Maus!
        window.addEventListener('wheel', resetHideTimer);

        // 4. Für die Senderliste selbst
        if (channelList) {
            channelList.addEventListener('scroll', resetHideTimer);
        }

        // Timer beim Start initialisieren
        resetHideTimer();

        // Beim Starten ausführen
        loadChannelsAndEPG();

        // EPG alle 60 Sekunden im Hintergrund aktualisieren
        setInterval(loadChannelsAndEPG, 60000);
    </script>
</body>

</html>